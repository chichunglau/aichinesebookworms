/**
 * 解析CSV文件内容
 * @param {string} csvContent - CSV文件内容
 * @return {array} 解析后的数据数组
 */
function parseCSV(csvContent) {
  try {
    const lines = csvContent.split('\n');
    const headers = lines[0].split(',').map(header => header.trim().replace(/"/g, ''));
    const data = [];
    
    for (let i = 1; i < lines.length; i++) {
      const line = lines[i].trim();
      if (!line) continue;
      
      const values = [];
      let currentValue = '';
      let inQuotes = false;
      
      for (let j = 0; j < line.length; j++) {
        const char = line[j];
        
        if (char === '"') {
          inQuotes = !inQuotes;
        } else if (char === ',' && !inQuotes) {
          values.push(currentValue.trim());
          currentValue = '';
        } else {
          currentValue += char;
        }
      }
      
      values.push(currentValue.trim());
      
      if (values.length === headers.length) {
        const row = {};
        headers.forEach((header, index) => {
          row[header] = values[index];
        });
        data.push(row);
      }
    }
    
    return data;
  } catch (error) {
    console.error('CSV parsing error:', error.message);
    return [];
  }
}

/**
 * 解析词语表CSV
 * @param {array} data - CSV数据
 * @return {object} 词语表对象
 */
function parseVocabularyCSV(data) {
  const vocabulary = {};
  
  data.forEach(row => {
    const level = row['等级'] || row['level'] || row['Level'];
    const word = row['词语'] || row['词汇'] || row['word'] || row['Word'];
    
    if (level && word) {
      if (!vocabulary[level]) {
        vocabulary[level] = [];
      }
      vocabulary[level].push(word.trim());
    }
  });
  
  return vocabulary;
}

/**
 * 解析语法点CSV
 * @param {array} data - CSV数据
 * @return {object} 语法点对象
 */
function parseGrammarCSV(data) {
  const grammar = {};
  
  data.forEach(row => {
    const level = row['等级'] || row['level'] || row['Level'];
    const grammarPoint = row['语法点'] || row['语法'] || row['grammar'] || row['Grammar'];
    
    if (level && grammarPoint) {
      if (!grammar[level]) {
        grammar[level] = [];
      }
      grammar[level].push(grammarPoint.trim());
    }
  });
  
  return grammar;
}

/**
 * 解析通用词CSV
 * @param {array} data - CSV数据
 * @return {array} 通用词数组
 */
function parseCommonWordsCSV(data) {
  const commonWords = [];
  
  data.forEach(row => {
    const word = row['通用词'] || row['词'] || row['word'] || row['Word'];
    if (word) {
      commonWords.push(word.trim());
    }
  });
  
  return commonWords;
}

/**
