/**
 * 检查词汇等级
 * @param {string} word - 词汇
 * @param {string} targetLevel - 目标等级
 * @return {object} 检查结果
 */
function checkWordLevel(word, targetLevel) {
  try {
    const vocabularyData = loadVocabularyData();
    const isAppropriate = isWordLevelAppropriate(word, targetLevel, vocabularyData);
    const wordLevel = getWordMaxLevel(word, vocabularyData);
    
    // 查找建议替换词
    const suggestions = [];
    if (!isAppropriate) {
      const replacement = findAppropriateReplacement(word, targetLevel, vocabularyData);
      if (replacement) {
        suggestions.push(replacement);
      }
      
      // 从目标等级词汇中添加一些建议
      const targetLevelNumber = getLevelNumber(targetLevel);
      const levels = ["P", "1", "2", "3", "4", "5", "6", "7", "A1", "A2", "B1", "B2", "C1", "C2"];
      
      for (let i = 0; i < levels.length; i++) {
        const level = levels[i];
        if (getLevelNumber(level) <= targetLevelNumber && vocabularyData.vocabulary[level]) {
          // 添加前3个词汇作为建议
          const levelWords = vocabularyData.vocabulary[level].slice(0, 3);
          suggestions.push(...levelWords);
          if (suggestions.length >= 5) break;
        }
      }
    }
    
    return {
      word: word,
      targetLevel: targetLevel,
      wordLevel: wordLevel,
      isAppropriate: isAppropriate,
      suggestions: suggestions.slice(0, 5) // 最多返回5个建议
    };
  } catch (error) {
    console.error('Error in checkWordLevel:', error.message);
    return {
      word: word,
      targetLevel: targetLevel,
      wordLevel: null,
      isAppropriate: false,
      suggestions: [],
      error: error.message
    };
  }
}

