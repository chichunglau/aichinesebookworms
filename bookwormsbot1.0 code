function getFolderContents() {
  try {
    if (!FOLDER_ID) return [];
    const folder = DriveApp.getFolderById(FOLDER_ID);
    const files = folder.getFiles();
    const contents = [];
    while (files.hasNext()) {
      const file = files.next();
      const mime = file.getMimeType();
      if (mime === MimeType.CSV || mime === MimeType.PLAIN_TEXT) {
        contents.push({
          "name": file.getName(),
          "data": file.getBlob().getDataAsString().substring(0, 3000)
        });
      }
    }
    return contents;
  } catch (e) {
    return [];
  }
}

/**
 * 最佳化的 Gemini API 呼叫函式
 * 採用穩定可用的 gemini-2.5-flash，提供優秀的中文文本處理能力
 */
function callGemini(userQuery, systemPrompt) {
  // 使用穩定可用的 Gemini 2.5 Flash 模型，在 API v1beta 中完全支援
  const modelId = "gemini-2.5-flash"; 
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${modelId}:generateContent?key=${API_KEY}`;
  
  const payload = {
    systemInstruction: { parts: [{ text: systemPrompt }] },
    contents: [{ parts: [{ text: userQuery }] }],
    // 將所有安全過濾器設定為 BLOCK_NONE，避免討論科技/社會議題時被誤擋
    safetySettings: [
      { category: "HARM_CATEGORY_HARASSMENT", threshold: "BLOCK_NONE" },
      { category: "HARM_CATEGORY_HATE_SPEECH", threshold: "BLOCK_NONE" },
      { category: "HARM_CATEGORY_SEXUALLY_EXPLICIT", threshold: "BLOCK_NONE" },
      { category: "HARM_CATEGORY_DANGEROUS_CONTENT", threshold: "BLOCK_NONE" }
    ],
    generationConfig: { 
      temperature: 0.7, // 提高温度参数以鼓励更多样化的输出
      maxOutputTokens: 8192,
      topP: 0.9,
      topK: 40
    }
  };

  const options = {
    method: "POST",
    contentType: "application/json",
    payload: JSON.stringify(payload),
    muteHttpExceptions: true 
  };

  try {
    const response = UrlFetchApp.fetch(url, options);
    const responseCode = response.getResponseCode();
    const responseText = response.getContentText();
    const result = JSON.parse(responseText);

    // 處理 HTTP 層級的錯誤
    if (responseCode !== 200) {
      const errorMsg = result.error ? result.error.message : "Unknown API Error";
      return `API Error (${responseCode}): ${errorMsg}`;
    }

    // 檢查是否有回傳 candidates
    if (result.candidates && result.candidates.length > 0) {
      const candidate = result.candidates[0];
      
      if (candidate.finishReason === "SAFETY") {
        return "The response was blocked by safety filters. Please try rephrasing your input.";
      }
      
      if (candidate.content && candidate.content.parts && candidate.content.parts[0].text) {
        return candidate.content.parts[0].text;
      }

      // 【除錯機制】如果模型回傳 HTTP 200，卻沒有給出任何文字，直接印出底層資訊
      return `[系統除錯] 模型當機或未產出文字。\nFinishReason: ${candidate.finishReason}\nAPI 原始回應: ${responseText}`;
    }

    if (result.promptFeedback && result.promptFeedback.blockReason) {
      return `Request blocked: ${result.promptFeedback.blockReason}`;
    }

    // 【除錯機制】如果完全沒有 candidates
    return `[系統除錯] 找不到生成的內容。\nAPI 原始回應: ${responseText}`;
    
  } catch (e) {
    console.error("fetch failed: " + e.toString());
    return "Connection error: Failed to reach Gemini AI service. Details: " + e.message;
  }
}

