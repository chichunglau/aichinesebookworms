/**
 * 分析文本词汇等级
 * @param {string} text - 要分析的文本
 * @param {string} targetLevel - 目标等级
 * @return {object} 分析结果
 */
function analyzeTextVocabulary(text, targetLevel) {
  // 加载词汇数据
  const vocabularyData = loadVocabularyData();
  const wordLevelMap = buildWordLevelMap(vocabularyData);
  
  const words = text.match(/[\u4e00-\u9fff]+/g) || [];
  const analysis = {
    totalWords: words.length,
    knownWords: 0,
    unknownWords: 0,
    levelWords: 0,
    beyondWords: 0,
    wordLevels: [],
    unknownWordsList: [],
    beyondWordsList: [],
    levelDistribution: {}
  };
  
  // 初始化等级分布
  Object.keys(vocabularyData.vocabulary).forEach(level => {
    analysis.levelDistribution[level] = 0;
  });
  analysis.levelDistribution['common'] = 0;
  analysis.levelDistribution['unknown'] = 0;
  
  words.forEach(word => {
    const level = wordLevelMap[word] || 'unknown';
    analysis.wordLevels.push({word, level});
    
    if (level === 'unknown') {
      analysis.unknownWords++;
      analysis.unknownWordsList.push(word);
      analysis.levelDistribution['unknown']++;
    } else {
      analysis.knownWords++;
      analysis.levelDistribution[level]++;
      
      // 检查是否符合目标等级
      if (level === 'common') {
        analysis.levelWords++;
      } else {
        const levelNumber = getLevelNumber(level);
        const targetLevelNumber = getLevelNumber(targetLevel);
        
        if (levelNumber <= targetLevelNumber) {
          analysis.levelWords++;
        } else {
          analysis.beyondWords++;
          analysis.beyondWordsList.push(word);
        }
      }
    }
  });
  
  // 计算百分比
  analysis.levelPercentage = analysis.totalWords > 0 ? 
    (analysis.levelWords / analysis.totalWords * 100).toFixed(1) : '0';
  analysis.beyondPercentage = analysis.totalWords > 0 ? 
    (analysis.beyondWords / analysis.totalWords * 100).toFixed(1) : '0';
  analysis.unknownPercentage = analysis.totalWords > 0 ? 
    (analysis.unknownWords / analysis.totalWords * 100).toFixed(1) : '0';
  
  // 检查是否符合95:5原则
  analysis.meetsPrinciple = parseFloat(analysis.levelPercentage) >= 95;
  
  return analysis;
}

/**
 * 检查95:5原则
 * @param {string} text - 要检查的文本
 * @param {string} targetLevel - 目标等级
 * @return {object} 检查结果
 */
function check955Principle(text, targetLevel) {
  const analysis = analyzeTextVocabulary(text, targetLevel);
  
  return {
    knownWords: analysis.levelWords,
    newWords: analysis.beyondWords,
    knownPercentage: analysis.levelPercentage,
    newPercentage: analysis.beyondPercentage,
    meetsPrinciple: analysis.meetsPrinciple,
    totalWords: analysis.totalWords,
    analysis: analysis
  };
}

/**
 * 根据95:5原则调整文本
 * @param {string} text - 要调整的文本
 * @param {string} targetLevel - 目标等级
 * @return {string} 调整后的文本
 */
function adjustTextBy955Principle(text, targetLevel) {
  const analysis = analyzeTextVocabulary(text, targetLevel);
  let adjustedText = text;
  
  // 如果已经符合95:5原则，直接返回
  if (analysis.meetsPrinciple) {
    return text;
  }
  
  // 加载词汇数据
  const vocabularyData = loadVocabularyData();
  
  // 替换超出等级的词汇
  analysis.beyondWordsList.forEach(word => {
    const replacement = findAppropriateReplacement(word, targetLevel, vocabularyData);
    if (replacement) {
      const regex = new RegExp(word, 'g');
      adjustedText = adjustedText.replace(regex, replacement);
    }
  });
  
  // 确保95:5原则
  const maxBeyondWords = Math.ceil(analysis.totalWords * 0.05);
  
  // 再次分析调整后的文本
  const adjustedAnalysis = analyzeTextVocabulary(adjustedText, targetLevel);
  
  // 如果仍然不符合，进一步调整
  if (!adjustedAnalysis.meetsPrinciple) {
    // 简化句子结构
    adjustedText = simplifySentenceStructure(adjustedText, targetLevel, vocabularyData);
    
    // 再次检查
    const finalAnalysis = analyzeTextVocabulary(adjustedText, targetLevel);
    if (!finalAnalysis.meetsPrinciple) {
      // 最后手段：删除一些超出等级的词汇或句子
      adjustedText = removeComplexElements(adjustedText, targetLevel, vocabularyData);
    }
  }
  
  return adjustedText;
}

/**
