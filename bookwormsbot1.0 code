    "黑洞": "黑色的洞"
  };
  
  // 检查是否有预定义的替换
  if (replacementMap[complexWord]) {
    return replacementMap[complexWord];
  }
  
  // 尝试从目标等级或更低等级中找到同义词
  const targetLevelNumber = getLevelNumber(targetLevel);
  const levels = ["P", "1", "2", "3", "4", "5", "6", "7", "A1", "A2", "B1", "B2", "C1", "C2"];
  
  for (let i = 0; i < levels.length; i++) {
    const level = levels[i];
    if (getLevelNumber(level) <= targetLevelNumber && vocabularyData.vocabulary[level]) {
      // 这里可以添加更复杂的同义词匹配逻辑
      // 目前简单返回第一个找到的词汇
      if (vocabularyData.vocabulary[level].length > 0) {
        return vocabularyData.vocabulary[level][0];
      }
    }
  }
  
  // 如果找不到替换词，返回原词
  return null;
}

/**
 * 简化句子结构
 * @param {string} text - 要简化的文本
 * @param {string} targetLevel - 目标等级
 * @param {object} vocabularyData - 词汇表数据
 * @return {string} 简化后的文本
 */
function simplifySentenceStructure(text, targetLevel, vocabularyData) {
  // 简单的句子简化逻辑
  let simplified = text;
  
  // 拆分复杂句子
  simplified = simplified.replace(/，([^。！？]*?)(但是|然而|不過)([^。！？]*?)[。！？]/g, '。$1。$3。');
  simplified = simplified.replace(/，([^。！？]*?)(因為|由於)([^。！？]*?)[。！？]/g, '。$1。$3。');
  simplified = simplified.replace(/，([^。！？]*?)(所以|因此)([^。！？]*?)[。！？]/g, '。$1。$3。');
  
  // 缩短句子长度
  const sentences = simplified.split(/[。！？]/);
  const simplifiedSentences = sentences.map(sentence => {
    if (sentence.length > 20) {
      // 简单截断并添加句号
      return sentence.substring(0, 20) + '。';
    }
    return sentence;
  });
  
  return simplifiedSentences.join('');
}

/**
 * 删除复杂元素
 * @param {string} text - 要处理的文本
 * @param {string} targetLevel - 目标等级
 * @param {object} vocabularyData - 词汇表数据
 * @return {string} 处理后的文本
 */
function removeComplexElements(text, targetLevel, vocabularyData) {
  const words = text.match(/[\u4e00-\u9fff]+/g) || [];
  let result = text;
  
  // 按照词汇长度排序，优先删除较长的词汇
  const sortedWords = words.sort((a, b) => b.length - a.length);
  
  for (let i = 0; i < sortedWords.length; i++) {
    const word = sortedWords[i];
    if (!isWordLevelAppropriate(word, targetLevel, vocabularyData)) {
      // 删除这个词汇
      const regex = new RegExp(word, 'g');
      result = result.replace(regex, '');
      
      // 检查是否已经符合95:5原则
      const analysis = analyzeTextVocabulary(result, targetLevel);
      if (analysis.meetsPrinciple) {
        break;
      }
    }
  }
  
  return result;
}
