      const data = (await res.json()) as { answer: string };
      setBilingualText(data.answer);
    } catch (e: any) {
      setBilingualText(`翻譯失敗：${e?.message ?? 'unknown'}`);
    } finally {
      setTranslating(false);
    }
  }

  return (
    <div className="space-y-4">
      <div className="grid gap-3 md:grid-cols-6">
        <div className="md:col-span-2">
          <label className="text-xs font-semibold text-slate-600">{tb('common.action')}</label>
