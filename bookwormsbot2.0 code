import { NextResponse } from 'next/server';
import { z } from 'zod';
import { db } from '@/db';
import { grammar, vocab } from '@/db/schema';
import { desc, lte } from 'drizzle-orm';
import { generateJson } from '@/lib/gemini';

const Body = z.object({
  uiLevel: z.string(),
  coreLevel: z.number().int().min(1).max(7),
  mode: z.enum(['mixed', 'vocab', 'grammar']).default('mixed'),
  count: z.number().int().min(4).max(20).default(8),
  // 可選：弱點模式（前端傳 true/false）
  weakMode: z.boolean().optional(),
});

export async function POST(req: Request) {
  const body = Body.parse(await req.json());

  const words = await db
    .select({ word: vocab.word, gloss: vocab.gloss })
    .from(vocab)
    .where(lte(vocab.levelNum, body.coreLevel))
    .orderBy(desc(vocab.wfreq))
    .limit(40);

  const points = await db
    .select({ name: grammar.name, description: grammar.description, example: grammar.example })
    .from(grammar)
    .where(lte(grammar.levelNum, body.coreLevel))
    .limit(30);

  const schema = {
    type: 'object',
    properties: {
      items: {
        type: 'array',
        items: {
          type: 'object',
          properties: {
            prompt: { type: 'string' },
            options: { type: 'array', items: { type: 'string' } },
            answer: { type: 'string' },
            explanation: { type: 'string' }
          },
          required: ['prompt', 'options', 'answer', 'explanation']
        }
      }
    },
    required: ['items']
  };

  const system = `You are a Chinese cloze quiz generator. Return ONLY JSON.`;

  const prompt = `Create ${body.count} cloze multiple-choice questions for Chinese learners.\n` +
    `Target level: Core Level ${body.coreLevel} (TBCL ${body.uiLevel}).\n` +
    `Mode: ${body.mode}. Weak-mode: ${body.weakMode ? 'ON' : 'OFF'}.\n\n` +
    `Vocabulary pool:\n${words.map(w => `- ${w.word}${w.gloss ? `: ${w.gloss}` : ''}`).join('\n')}\n\n` +
    `Grammar pool:\n${points.map(g => `- ${g.name}${g.example ? ` | ${g.example}` : ''}`).join('\n')}\n\n` +
    `Rules:\n` +
    `- Each item has: prompt with one blank like ____\n` +
    `- options: 4 strings\n` +
    `- answer must be one of the options\n` +
    `- explanation: short and clear\n`;

  const out = await generateJson<any>({ system, prompt, schema, temperature: 0.6, maxOutputTokens: 1800 });
  return NextResponse.json(out);
}
```

