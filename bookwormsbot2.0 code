function loadWrongBank(): ClozeItem[] {
  try {
    const raw = localStorage.getItem(WRONG_KEY);
    if (!raw) return [];
    const arr = JSON.parse(raw);
    if (!Array.isArray(arr)) return [];
    return arr as ClozeItem[];
  } catch {
    return [];
  }
}

function saveWrongBank(items: ClozeItem[]) {
  localStorage.setItem(WRONG_KEY, JSON.stringify(items.slice(0, 200)));
}

export function PracticePanel({ level }: { level: UiLevelKey }) {
  const coreLevel = toCoreLevelNumber(level);
  const { lang, tb } = useI18n();

  const [mode, setMode] = useState<'mixed' | 'vocab' | 'grammar'>('mixed');
  const [count, setCount] = useState(8);
  const [weakMode, setWeakMode] = useState(false);

  const [loading, setLoading] = useState(false);
  const [items, setItems] = useState<ClozeItem[]>([]);
  const [picked, setPicked] = useState<Record<number, string>>({});
  const [reveal, setReveal] = useState(false);

  const [bilingualExplainOn, setBilingualExplainOn] = useState(false);
  const [bilingualText, setBilingualText] = useState('');
  const [translating, setTranslating] = useState(false);

  const score = useMemo(() => {
    if (!reveal) return null;
    let s = 0;
    items.forEach((it, idx) => {
      if (picked[idx] === it.answer) s += 1;
    });
    return s;
  }, [items, picked, reveal]);

  async function generate() {
    setLoading(true);
    setReveal(false);
    setPicked({});
    setBilingualText('');

    try {
      const res = await fetch('/api/practice/cloze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uiLevel: level, coreLevel, mode, count, weakMode }),
