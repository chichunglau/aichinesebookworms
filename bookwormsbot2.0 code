'use client';

import React, { createContext, useContext, useEffect, useMemo, useState } from 'react';
import type { Lang, I18nKey } from '@/lib/i18n';
import { t as tt } from '@/lib/i18n';

type Ctx = {
  lang: Lang;
  setLang: (l: Lang) => void;
  bilingualUI: boolean;
  setBilingualUI: (v: boolean) => void;
  t: (key: I18nKey) => string;
  tb: (key: I18nKey) => string; // bilingual label
};

const I18nCtx = createContext<Ctx | null>(null);

export function I18nProvider({ children }: { children: React.ReactNode }) {
  const [lang, setLang] = useState<Lang>('en');
  const [bilingualUI, setBilingualUI] = useState(true);

  useEffect(() => {
    const saved = localStorage.getItem('tbcl_lang') as Lang | null;
    const bi = localStorage.getItem('tbcl_bilingual_ui');
    if (saved) setLang(saved);
    if (bi) setBilingualUI(bi === '1');
  }, []);

  useEffect(() => {
    localStorage.setItem('tbcl_lang', lang);
  }, [lang]);

  useEffect(() => {
    localStorage.setItem('tbcl_bilingual_ui', bilingualUI ? '1' : '0');
  }, [bilingualUI]);

  const value = useMemo<Ctx>(() => {
    return {
      lang,
      setLang,
      bilingualUI,
      setBilingualUI,
      t: (k) => tt(k, 'zh'),
      tb: (k) => (bilingualUI ? `${tt(k, 'zh')} / ${tt(k, lang)}` : tt(k, 'zh')),
    };
  }, [lang, bilingualUI]);

  return <I18nCtx.Provider value={value}>{children}</I18nCtx.Provider>;
}

export function useI18n() {
  const ctx = useContext(I18nCtx);
  if (!ctx) throw new Error('useI18n must be used within I18nProvider');
  return ctx;
}
