### 9.7 ✅ src/app/api/text/rewrite/route.ts（上傳檔案 → 用語料庫改寫/標註）

* 前端以 `multipart/form-data` 上傳 `.txt/.md/.docx`
* 後端抽「不高於等級」的常用詞 + 語法點，讓模型：

  * 依 action（simplify/upgrade/correct/annotate）改寫
  * 並回傳 changeLog + 針對語法/詞彙的教學說明

```ts
import { NextResponse } from 'next/server';
import { z } from 'zod';
import { db } from '@/db';
import { grammar, vocab } from '@/db/schema';
import { desc, lte } from 'drizzle-orm';
import { generateJson } from '@/lib/gemini';
import { fileToText, normalizeText } from '@/lib/text';

const Form = z.object({
  uiLevel: z.string(),
  coreLevel: z.coerce.number().int().min(1).max(7),
  action: z.enum(['simplify', 'upgrade', 'correct', 'annotate']).default('simplify'),
  lang: z.string().nullable().optional(),
});

export async function POST(req: Request) {
  const form = await req.formData();

  const uiLevel = String(form.get('uiLevel') ?? '2+');
  const coreLevel = Number(form.get('coreLevel') ?? '2') || 2;
  const action = String(form.get('action') ?? 'simplify') as any;
  const lang = (form.get('lang') ? String(form.get('lang')) : null) as string | null;

  const parsed = Form.parse({ uiLevel, coreLevel, action, lang });

  const file = form.get('file');
  if (!file || !(file instanceof File)) {
    return NextResponse.json({ error: 'Missing file' }, { status: 400 });
  }

  // ✅ 基本大小保護（Vercel Functions 有 request body 限制；也避免記憶體爆）
  if (file.size > 1_500_000) {
    return NextResponse.json(
      { error: 'File too large. Please keep it under ~1.5MB (use .txt/.docx with shorter content).' },
      { status: 413 }
    );
  }

  let originalText = '';
  try {
    originalText = normalizeText(await fileToText(file));
  } catch (e: any) {
    return NextResponse.json({ error: e?.message ?? 'Failed to read file' }, { status: 400 });
  }

  if (!originalText) {
    return NextResponse.json({ error: 'Empty text' }, { status: 400 });
  }

  const words = await db
    .select({ word: vocab.word, gloss: vocab.gloss, pinyin: vocab.pinyin })
    .from(vocab)
    .where(lte(vocab.levelNum, parsed.coreLevel))
    .orderBy(desc(vocab.wfreq))
    .limit(50);

  const points = await db
    .select({ name: grammar.name, description: grammar.description, example: grammar.example })
    .from(grammar)
    .where(lte(grammar.levelNum, parsed.coreLevel))
    .limit(35);

  const schema = {
    type: 'object',
    properties: {
      revisedText: { type: 'string' },
      changeLog: { type: 'array', items: { type: 'string' } },
      teachNotes: {
        type: 'object',
        properties: {
          grammar: {
            type: 'array',
            items: {
              type: 'object',
              properties: {
                name: { type: 'string' },
                explanation: { type: 'string' },
                examples: { type: 'array', items: { type: 'string' } }
              },
              required: ['name', 'explanation', 'examples']
            }
          },
          vocab: {
            type: 'array',
            items: {
              type: 'object',
              properties: {
                word: { type: 'string' },
                gloss: { type: 'string' },
                examples: { type: 'array', items: { type: 'string' } }
              },
              required: ['word', 'examples']
            }
          }
        },
        required: ['grammar', 'vocab']
      },
      bilingual: {
        type: 'object',
        properties: {
          lang: { type: 'string' },
          revisedText: { type: 'string' },
          teachNotes: { type: 'string' }
        }
      }
    },
    required: ['revisedText', 'changeLog', 'teachNotes']
  };

  const bilingualHint = parsed.lang
    ? `\nAdditionally provide bilingual fields: bilingual.lang, bilingual.revisedText, bilingual.teachNotes in ${parsed.lang}.`
    : '';

  const system = `You are a Chinese teaching editor for international students in Taiwan. Return ONLY JSON.`;

  const actionGuide: Record<string, string> = {
    simplify: 'Rewrite the text to be simpler, mostly using Core Level vocabulary/grammar, while keeping meaning.',
    upgrade: 'Rewrite the text to be more advanced but still within the target level. Improve style and cohesion.',
    correct: 'Correct grammar/wording, keep original level as much as possible, and improve naturalness.',
    annotate: 'Keep the text mostly the same, but revise small parts to match target level and make it teachable.',
  };

  const prompt = `TASK: ${actionGuide[parsed.action] ?? actionGuide.simplify}\n` +
    `Target: Core Level ${parsed.coreLevel} (TBCL ${parsed.uiLevel}).\n` +
    `Original text:\n---\n${originalText}\n---\n\n` +
    `Use mostly these vocabulary (not necessarily all):\n` +
    words.map(w => `- ${w.word}${w.pinyin ? ` (${w.pinyin})` : ''}${w.gloss ? `: ${w.gloss}` : ''}`).join('\n') +
    `\n\nPrefer these grammar points (not necessarily all):\n` +
    points.map(g => `- ${g.name}${g.example ? ` | ex: ${g.example}` : ''}`).join('\n') +
    `\n\nOutput:\n` +
    `- revisedText (Traditional Chinese)\n` +
    `- changeLog: 6~12 bullets, what you changed and why\n` +
    `- teachNotes: pick 5~8 grammar points used + 8~14 key vocab with short explanations and 2 examples each\n` +
    bilingualHint;

  const out = await generateJson<any>({ system, prompt, schema, temperature: 0.35, maxOutputTokens: 2200 });

  return NextResponse.json({
    originalText,
    ...out,
  });
}
