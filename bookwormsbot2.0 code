## 6) Seed（把你上傳的 xlsx 灌進 Postgres）

> 你只要把 xlsx 檔名對應好放在 `data/`，就能 `pnpm db:seed`。

### scripts/seed.ts

```ts
import 'dotenv/config';
import * as XLSX from 'xlsx';
import { db } from '@/db';
import { vocab, grammar } from '@/db/schema';

function readSheet(filePath: string, sheetName?: string) {
  const wb = XLSX.readFile(filePath);
  const name = sheetName ?? wb.SheetNames[0];
  const ws = wb.Sheets[name];
  return XLSX.utils.sheet_to_json<Record<string, any>>(ws, { defval: '' });
}

async function main() {
  // ✅ 1) 詞彙表（請依你的實際欄名調整 mapping）
  // 假設欄名：詞語、拼音、注音、級別、情境、釋義
  const vocabRows = readSheet('data/14452詞語表.xlsx');
  const vocabInserts = vocabRows
    .map((r) => {
      const word = String(r['詞語'] ?? r['词语'] ?? r['word'] ?? '').trim();
      if (!word) return null;
      const levelNum = Number(r['級別'] ?? r['级别'] ?? r['level'] ?? 1) || 1;
      return {
        word,
        pinyin: String(r['拼音'] ?? r['pinyin'] ?? '').trim() || null,
        bopomofo: String(r['注音'] ?? r['bopomofo'] ?? '').trim() || null,
        gloss: String(r['釋義'] ?? r['释义'] ?? r['gloss'] ?? '').trim() || null,
        levelNum,
        situation: String(r['情境'] ?? r['situation'] ?? '').trim() || null,
      };
    })
    .filter(Boolean) as any[];

  if (vocabInserts.length) {
    // 簡單分批避免單次太大
    const chunk = 1000;
    for (let i = 0; i < vocabInserts.length; i += chunk) {
      await db.insert(vocab).values(vocabInserts.slice(i, i + chunk));
      console.log(`Inserted vocab: ${Math.min(i + chunk, vocabInserts.length)}/${vocabInserts.length}`);
    }
  }

  // ✅ 2) 語法點表（請依你的實際欄名調整 mapping）
  // 假設欄名：語法點、級別、等別、說明、例句
  const grammarRows = readSheet('data/臺灣華語文能力基準語法點表.xlsx');
  const grammarInserts = grammarRows
    .map((r) => {
      const name = String(r['語法點'] ?? r['语法点'] ?? r['name'] ?? '').trim();
      if (!name) return null;
      const levelNum = Number(r['級別'] ?? r['级别'] ?? r['level'] ?? 1) || 1;
      return {
        name,
        levelNum,
        tier: String(r['等別'] ?? r['tier'] ?? '').trim() || null,
        description: String(r['說明'] ?? r['说明'] ?? r['description'] ?? '').trim() || null,
        example: String(r['例句'] ?? r['example'] ?? '').trim() || null,
      };
    })
    .filter(Boolean) as any[];

  if (grammarInserts.length) {
    const chunk = 1000;
    for (let i = 0; i < grammarInserts.length; i += chunk) {
      await db.insert(grammar).values(grammarInserts.slice(i, i + chunk));
      console.log(`Inserted grammar: ${Math.min(i + chunk, grammarInserts.length)}/${grammarInserts.length}`);
    }
  }

  console.log('✅ Seed done');
}

main().catch((e) => {
  console.error(e);
  process.exit(1);
});
```

