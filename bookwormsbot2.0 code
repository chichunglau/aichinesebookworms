    if (wrongNow.length) {
      const bank = loadWrongBank();
      // 去重（用 prompt 作 key）
      const merged = [...wrongNow, ...bank];
      const map = new Map<string, ClozeItem>();
      for (const it of merged) map.set(it.prompt, it);
      saveWrongBank(Array.from(map.values()));
