          />
        </div>

        <div className="md:col-span-1">
          <label className="text-xs font-semibold text-slate-600">{tb('common.level')}</label>
          <div className="mt-1 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm">
            TBCL {level} → <span className="font-semibold">{coreLevelLabel(coreLevel)}</span>
          </div>
        </div>

        <div className="md:col-span-1">
          <label className="text-xs font-semibold text-slate-600">文體</label>
          <select
            value={genre}
            onChange={(e) => setGenre(e.target.value as any)}
