'use client';

import { useEffect, useMemo, useState } from 'react';
import type { UiLevelKey } from '@/lib/levels';
import { toCoreLevelNumber } from '@/lib/levels';
import { useI18n } from '@/components/I18nProvider';

type VocabRow = {
  word: string;
  pinyin?: string;
  bopomofo?: string;
  gloss?: string;
  levelNum: number;
  situation?: string;
  wfreq?: number;
  sfreq?: number;
};

type GrammarRow = {
  name: string;
  levelNum: number;
  tier?: string;
  description?: string;
  example?: string;
};

type SavedItem =
  | { type: 'vocab'; data: VocabRow }
  | { type: 'grammar'; data: GrammarRow };

const SAVE_KEY = 'tbcl_saved_v1';

function loadSaved(): SavedItem[] {
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return [];
    const arr = JSON.parse(raw);
    if (!Array.isArray(arr)) return [];
    return arr as SavedItem[];
  } catch {
    return [];
  }
}

function saveSaved(items: SavedItem[]) {
  localStorage.setItem(SAVE_KEY, JSON.stringify(items.slice(0, 500)));
}

function download(name: string, content: string, mime = 'application/json') {
  const blob = new Blob([content], { type: mime });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

export function SearchPanel({ level }: { level: UiLevelKey }) {
  const coreLevel = toCoreLevelNumber(level);
  const { tb } = useI18n();

  const [mode, setMode] = useState<'vocab' | 'grammar'>('vocab');
  const [q, setQ] = useState('');
  const [loading, setLoading] = useState(false);
  const [vocab, setVocab] = useState<VocabRow[]>([]);
  const [grammar, setGrammar] = useState<GrammarRow[]>([]);

  const [saved, setSaved] = useState<SavedItem[]>([]);

  useEffect(() => {
    setSaved(loadSaved());
  }, []);

  useEffect(() => {
    void runSearch('');
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [mode, level]);

  const savedCount = saved.length;

  function addSaved(item: SavedItem) {
    const next = [item, ...saved];
    // 去重：vocab 用 word；grammar 用 name
    const map = new Map<string, SavedItem>();
    for (const it of next) {
      const key = it.type === 'vocab' ? `v:${it.data.word}` : `g:${it.data.name}`;
      map.set(key, it);
    }
    const arr = Array.from(map.values());
    setSaved(arr);
    saveSaved(arr);
  }

  function removeSaved(item: SavedItem) {
    const key = item.type === 'vocab' ? `v:${item.data.word}` : `g:${item.data.name}`;
    const next = saved.filter((it) => (it.type === 'vocab' ? `v:${it.data.word}` : `g:${it.data.name}`) !== key);
    setSaved(next);
    saveSaved(next);
  }

  function exportJson() {
    download('tbcl_saved.json', JSON.stringify(saved, null, 2));
  }

  function exportCsv() {
    const rows: string[] = [];
    rows.push(['type', 'name/word', 'level', 'pinyin', 'bopomofo', 'gloss/description', 'example'].join(','));
    for (const it of saved) {
      if (it.type === 'vocab') {
        const v = it.data;
        rows.push(
          [
            'vocab',
            v.word,
            String(v.levelNum),
            v.pinyin ?? '',
            v.bopomofo ?? '',
            (v.gloss ?? '').replace(/
/g, ' '),
            '',
          ]
            .map((x) => `"${String(x).replace(/"/g, '""')}"`)
            .join(',')
        );
      } else {
        const g = it.data;
        rows.push(
          [
            'grammar',
            g.name,
            String(g.levelNum),
            '',
            '',
            (g.description ?? '').replace(/
/g, ' '),
            (g.example ?? '').replace(/
/g, ' '),
          ]
            .map((x) => `"${String(x).replace(/"/g, '""')}"`)
            .join(',')
        );
      }
    }
    download('tbcl_saved.csv', rows.join('
'), 'text/csv');
  }

  async function runSearch(query: string) {
    setLoading(true);
    try {
      if (mode === 'vocab') {
        const url = new URL('/api/search/vocab', window.location.origin);
        url.searchParams.set('q', query);
        url.searchParams.set('coreLevel', String(coreLevel));
        const res = await fetch(url.toString());
        if (!res.ok) throw new Error(await res.text());
        const data = (await res.json()) as { items: VocabRow[] };
        setVocab(data.items);
      } else {
        const url = new URL('/api/search/grammar', window.location.origin);
        url.searchParams.set('q', query);
        url.searchParams.set('coreLevel', String(coreLevel));
        const res = await fetch(url.toString());
        if (!res.ok) throw new Error(await res.text());
        const data = (await res.json()) as { items: GrammarRow[] };
        setGrammar(data.items);
      }
    } catch (e: any) {
      alert(e?.message ?? '查詢失敗');
    } finally {
      setLoading(false);
    }
  }

  const savedPanel = useMemo(() => {
    return (
      <div className="rounded-2xl border border-slate-200 bg-white p-4">
        <div className="flex items-center justify-between gap-2">
          <div className="text-sm font-semibold">收藏（{savedCount}）</div>
          <div className="flex items-center gap-2">
            <button
              className="rounded-lg bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-200"
              onClick={exportJson}
            >
              Export JSON
            </button>
            <button
              className="rounded-lg bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-200"
              onClick={exportCsv}
            >
              Export CSV
            </button>
            <button
              className="rounded-lg bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-100"
              onClick={() => {
                if (!confirm('確定清空收藏？')) return;
                setSaved([]);
                saveSaved([]);
              }}
            >
              Clear
            </button>
          </div>
        </div>

        {!saved.length ? (
          <div className="mt-3 text-sm text-slate-500">尚無收藏。查到詞/語法後點「收藏」即可。</div>
        ) : (
          <div className="mt-3 space-y-2">
            {saved.map((it, idx) => (
              <div key={idx} className="rounded-xl bg-slate-50 p-3">
                <div className="flex items-start justify-between gap-2">
                  <div>
                    <div className="text-sm font-semibold">
                      {it.type === 'vocab' ? it.data.word : it.data.name}
                      <span className="ml-2 text-xs text-slate-500">({it.type})</span>
                    </div>
                    <div className="mt-1 text-xs text-slate-600">第{it.data.levelNum}級</div>
                    {it.type === 'vocab' ? (
                      <div className="mt-1 text-xs text-slate-600">{it.data.pinyin ?? ''} {it.data.bopomofo ? `(${it.data.bopomofo})` : ''}</div>
                    ) : null}
                    {it.type === 'vocab' && it.data.gloss ? (
                      <div className="mt-1 text-sm text-slate-700">{it.data.gloss}</div>
                    ) : null}
                    {it.type === 'grammar' && it.data.example ? (
                      <div className="mt-1 text-sm text-slate-700">例：{it.data.example}</div>
                    ) : null}
                  </div>
                  <button
                    className="rounded-lg bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm ring-1 ring-slate-200 hover:bg-slate-50"
                    onClick={() => removeSaved(it)}
                  >
                    移除
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    );
  }, [saved, savedCount]);

  return (
    <div className="space-y-4">
      <div className="grid gap-3 md:grid-cols-6">
        <div className="md:col-span-2">
          <label className="text-xs font-semibold text-slate-600">查詢類型</label>
          <select
            value={mode}
            onChange={(e) => setMode(e.target.value as any)}
            className="mt-1 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:bg-white focus:ring-2 focus:ring-blue-500"
          >
            <option value="vocab">詞彙</option>
            <option value="grammar">語法點</option>
          </select>
        </div>

        <div className="md:col-span-4">
          <label className="text-xs font-semibold text-slate-600">關鍵字</label>
          <div className="mt-1 flex gap-2">
            <input
              value={q}
              onChange={(e) => setQ(e.target.value)}
              className="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:bg-white focus:ring-2 focus:ring-blue-500"
              placeholder={mode === 'vocab' ? '例如：愛 / ㄅㄚ / ai' : '例如：把字句 / 的 / 連詞…'}
              onKeyDown={(e) => {
                if (e.key === 'Enter') {
                  e.preventDefault();
                  void runSearch(q);
                }
              }}
            />
            <button
              onClick={() => runSearch(q)}
              disabled={loading}
              className="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-slate-800 disabled:opacity-60"
            >
              {loading ? '查…' : tb('common.search')}
            </button>
          </div>
          <div className="mt-1 text-[11px] text-slate-500">會優先回傳「不高於目前等級」的結果。</div>
        </div>
      </div>

      <div className="grid gap-4 lg:grid-cols-3">
        <div className="lg:col-span-2">
          {mode === 'vocab' ? (
            <div className="overflow-hidden rounded-2xl border border-slate-200">
              <div className="grid grid-cols-12 bg-slate-50 px-4 py-2 text-xs font-semibold text-slate-600">
                <div className="col-span-3">詞</div>
                <div className="col-span-3">拼音/注音</div>
                <div className="col-span-2">級</div>
                <div className="col-span-2">釋義</div>
                <div className="col-span-2">操作</div>
              </div>
              <div className="divide-y divide-slate-200 bg-white">
                {vocab.map((it, idx) => (
                  <div key={idx} className="grid grid-cols-12 items-center px-4 py-2 text-sm">
                    <div className="col-span-3 font-semibold">{it.word}</div>
                    <div className="col-span-3 text-slate-700">
                      {it.pinyin ?? ''} {it.bopomofo ? `(${it.bopomofo})` : ''}
                    </div>
                    <div className="col-span-2 text-slate-600">第{it.levelNum}級</div>
                    <div className="col-span-2 text-slate-600 line-clamp-2">{it.gloss ?? ''}</div>
                    <div className="col-span-2">
                      <button
                        className="rounded-lg bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-200"
                        onClick={() => addSaved({ type: 'vocab', data: it })}
                      >
                        收藏
                      </button>
                    </div>
                  </div>
                ))}
                {!vocab.length ? (
                  <div className="px-4 py-6 text-center text-sm text-slate-500">沒有結果（或資料尚未 seed）。</div>
                ) : null}
              </div>
            </div>
          ) : (
            <div className="space-y-3">
              {grammar.map((g, idx) => (
                <div key={idx} className="rounded-2xl border border-slate-200 bg-white p-4">
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <div className="text-base font-bold">{g.name}</div>
                      <div className="mt-1 text-xs text-slate-500">第{g.levelNum}級 {g.tier ? `· ${g.tier}` : ''}</div>
                    </div>
                    <button
                      className="rounded-lg bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-200"
                      onClick={() => addSaved({ type: 'grammar', data: g })}
                    >
                      收藏
                    </button>
                  </div>

                  {g.description ? (
                    <div className="mt-2 rounded-xl bg-slate-50 p-3 text-sm text-slate-700">{g.description}</div>
                  ) : null}
                  {g.example ? (
                    <div className="mt-2 rounded-xl bg-slate-50 p-3 text-sm text-slate-700">例句：{g.example}</div>
                  ) : null}
                </div>
              ))}
              {!grammar.length ? (
                <div className="rounded-xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
                  沒有結果（或資料尚未 seed）。
                </div>
              ) : null}
            </div>
          )}
        </div>

        <div className="lg:col-span-1">{savedPanel}</div>
      </div>
    </div>
  );
}
