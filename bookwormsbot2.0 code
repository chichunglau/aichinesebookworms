### 9.2 src/app/api/search/vocab/route.ts

```ts
import { NextResponse } from 'next/server';
import { db } from '@/db';
import { vocab } from '@/db/schema';
import { and, ilike, lte, or } from 'drizzle-orm';

export async function GET(req: Request) {
  const { searchParams } = new URL(req.url);
  const q = (searchParams.get('q') ?? '').trim();
  const coreLevel = Number(searchParams.get('coreLevel') ?? '7') || 7;

  const where = and(
    lte(vocab.levelNum, coreLevel),
    q
      ? or(
          ilike(vocab.word, `%${q}%`),
          ilike(vocab.pinyin, `%${q}%`),
          ilike(vocab.bopomofo, `%${q}%`)
        )
      : undefined
  );

  const items = await db
    .select({
      word: vocab.word,
      pinyin: vocab.pinyin,
      bopomofo: vocab.bopomofo,
      gloss: vocab.gloss,
      levelNum: vocab.levelNum,
      situation: vocab.situation,
      wfreq: vocab.wfreq,
      sfreq: vocab.sfreq,
    })
    .from(vocab)
    .where(where)
    .limit(50);

  return NextResponse.json({ items });
}
```

