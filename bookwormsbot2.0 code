### 17.4 `src/components/ChatPanel.tsx`

```tsx
'use client';

import { useMemo, useRef, useState } from 'react';
import type { UiLevelKey } from '@/lib/levels';
import { toCoreLevelNumber, coreLevelLabel } from '@/lib/levels';
import { useI18n } from '@/components/I18nProvider';

type Msg = { role: 'user' | 'assistant'; text: string };

export function ChatPanel({ level }: { level: UiLevelKey }) {
  const coreLevel = toCoreLevelNumber(level);
  const { lang } = useI18n();

  const [bilingualAnswer, setBilingualAnswer] = useState(true);
  const [input, setInput] = useState('');
  const [messages, setMessages] = useState<Msg[]>([
    {
      role: 'assistant',
      text:
        `我是你的華語教學助理。你可以：
` +
        `- 貼一段文章，叫我「標出第${coreLevel}級以內的詞彙/語法點」
` +
        `- 叫我把同一句改寫成更簡單或更進階
` +
        `- 要我出 5 題小測驗（選擇題/克漏字/改錯）

` +
        `先丟一句你要處理的文本就行。`,
    },
  ]);
  const [loading, setLoading] = useState(false);
  const boxRef = useRef<HTMLDivElement | null>(null);

  const quick = useMemo(
    () => [
      { label: '標註詞彙/語法', text: `請標出這段文本中「第${coreLevel}級以內」的常用詞彙與語法點，並簡短解釋。

` },
      { label: '簡化', text: `請把下面句子簡化到第${coreLevel}級，意思不變：

` },
      { label: '進階改寫', text: `請把下面句子改寫得更自然、較進階，但仍不超過第${coreLevel}級：

` },
      { label: '出 5 題練習', text: `請針對下面內容出 5 題練習題（含答案與解析），題型混合：選擇題/克漏字/改錯：

` },
    ],
    [coreLevel]
  );

  async function send(textOverride?: string) {
    const text = (textOverride ?? input).trim();
    if (!text || loading) return;

    setMessages((m) => [...m, { role: 'user', text }]);
    setInput('');
    setLoading(true);

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          uiLevel: level,
          coreLevel,
          message: text,
          lang: bilingualAnswer ? lang : null,
        }),
      });
      if (!res.ok) throw new Error(await res.text());
      const data = (await res.json()) as { answer: string };
      setMessages((m) => [...m, { role: 'assistant', text: data.answer }]);

      setTimeout(() => {
        boxRef.current?.scrollTo({ top: boxRef.current.scrollHeight, behavior: 'smooth' });
      }, 0);
    } catch (e: any) {
      setMessages((m) => [...m, { role: 'assistant', text: `抱歉，我這邊回應失敗：${e?.message ?? 'unknown'}` }]);
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <div>
          當前等級：<span className="font-semibold">{coreLevelLabel(coreLevel)}</span>
          <span className="ml-2 text-xs text-slate-500">（我會盡量用這個等級的詞彙與句型）</span>
        </div>
        <label className="flex items-center gap-2 rounded-full bg-white px-3 py-2 text-xs font-semibold shadow-sm ring-1 ring-slate-200">
          <input type="checkbox" checked={bilingualAnswer} onChange={(e) => setBilingualAnswer(e.target.checked)} />
          雙語回答（中文 / {lang}）
        </label>
      </div>

      <div className="flex flex-wrap gap-2">
        {quick.map((q) => (
          <button
            key={q.label}
            className="rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm ring-1 ring-slate-200 hover:bg-slate-50"
            onClick={() => setInput(q.text)}
          >
            {q.label}
          </button>
        ))}
      </div>

      <div ref={boxRef} className="h-[420px] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4">
        <div className="space-y-3">
          {messages.map((m, idx) => (
            <div
              key={idx}
              className={
                'max-w-[85%] whitespace-pre-wrap rounded-2xl px-4 py-3 text-sm leading-7 ' +
                (m.role === 'user' ? 'ml-auto bg-blue-600 text-white' : 'bg-slate-50 text-slate-800')
              }
            >
              {m.text}
            </div>
          ))}
          {loading ? (
            <div className="max-w-[85%] rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-500">思考中…</div>
          ) : null}
        </div>
      </div>

      <div className="flex gap-2">
        <textarea
          value={input}
          onChange={(e) => setInput(e.target.value)}
          rows={2}
          className="w-full resize-none rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="輸入訊息（Enter 送出 / Shift+Enter 換行）"
          onKeyDown={(e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
              e.preventDefault();
              void send();
            }
          }}
        />
        <button
          onClick={() => send()}
          disabled={loading}
          className="h-[54px] shrink-0 rounded-2xl bg-blue-600 px-4 text-sm font-semibold text-white shadow hover:bg-blue-700 disabled:opacity-60"
        >
          送出
        </button>
      </div>
    </div>
  );
}
