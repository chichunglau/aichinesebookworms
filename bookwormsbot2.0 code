export type UiLevelKey = 'P' | '1' | '2' | '2+' | '3' | '3+' | '4' | '5' | '6' | '7';

export const UI_LEVELS: { key: UiLevelKey; tbclLabel: string; cefr?: string; colorClass: string }[] = [
  { key: 'P', tbclLabel: 'P', colorClass: 'text-slate-500' },
  { key: '1', tbclLabel: '1', cefr: 'Novice 1', colorClass: 'text-emerald-600' },
  { key: '2', tbclLabel: '2', cefr: 'Novice 2', colorClass: 'text-emerald-600' },
  { key: '2+', tbclLabel: '2+', cefr: 'A1', colorClass: 'text-sky-600' },
  { key: '3', tbclLabel: '3', colorClass: 'text-slate-500' },
  { key: '3+', tbclLabel: '3+', cefr: 'A2', colorClass: 'text-sky-600' },
  { key: '4', tbclLabel: '4', cefr: 'B1', colorClass: 'text-amber-600' },
  { key: '5', tbclLabel: '5', cefr: 'B2', colorClass: 'text-amber-600' },
  { key: '6', tbclLabel: '6', cefr: 'C1', colorClass: 'text-red-600' },
  { key: '7', tbclLabel: '7', cefr: 'C2', colorClass: 'text-red-600' },
];

export function uiLevelFromSlider(value: number): UiLevelKey {
  return UI_LEVELS[Math.max(0, Math.min(UI_LEVELS.length - 1, value))].key;
}

export function sliderFromUiLevel(level: UiLevelKey): number {
  const idx = UI_LEVELS.findIndex((l) => l.key === level);
  return idx >= 0 ? idx : 0;
}

export function toCoreLevelNumber(level: UiLevelKey): number {
  switch (level) {
    case 'P':
    case '1':
      return 1;
    case '2':
    case '2+':
      return 2;
    case '3':
    case '3+':
      return 3;
    case '4':
      return 4;
    case '5':
      return 5;
    case '6':
      return 6;
    case '7':
      return 7;
    default:
      return 1;
  }
}

export function coreLevelLabel(levelNum: number): string {
  return `第${levelNum}級`;
}
