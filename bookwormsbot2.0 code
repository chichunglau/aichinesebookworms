```tsx
'use client';

import { useMemo, useState } from 'react';
import type { UiLevelKey } from '@/lib/levels';
import { coreLevelLabel, toCoreLevelNumber } from '@/lib/levels';
import { useI18n } from '@/components/I18nProvider';

type TeachNotes = {
  grammar: { name: string; explanation: string; examples: string[] }[];
  vocab: { word: string; gloss?: string; examples: string[] }[];
};

type Result = {
  originalText: string;
  revisedText: string;
  changeLog: string[];
  teachNotes: TeachNotes;
  bilingual?: { lang: string; revisedText: string; teachNotes: string };
};

export function UploadRewritePanel({ level }: { level: UiLevelKey }) {
  const coreLevel = toCoreLevelNumber(level);
  const { lang, tb } = useI18n();

  const [file, setFile] = useState<File | null>(null);
  const [action, setAction] = useState<'simplify' | 'upgrade' | 'correct' | 'annotate'>('simplify');
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<Result | null>(null);
  const [error, setError] = useState<string | null>(null);

  const accept = useMemo(() => '.txt,.md,.docx', []);

  async function run() {
    if (!file) return;
    setLoading(true);
    setError(null);
    setResult(null);

    try {
      const fd = new FormData();
      fd.set('file', file);
      fd.set('uiLevel', level);
      fd.set('coreLevel', String(coreLevel));
      fd.set('action', action);
      // ✅ 這裡把「你選的介面語言」傳給後端做雙語欄位
      fd.set('lang', lang);

      const res = await fetch('/api/text/rewrite', {
        method: 'POST',
        body: fd,
      });

      if (!res.ok) {
        const msg = await res.text();
        throw new Error(msg || `HTTP ${res.status}`);
