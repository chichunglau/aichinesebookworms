'use client';

import { useMemo, useState } from 'react';
import type { UiLevelKey } from '@/lib/levels';
import { coreLevelLabel, toCoreLevelNumber } from '@/lib/levels';
import { useI18n } from '@/components/I18nProvider';

type Analysis = {
  title: string;
  article: string;
  levelLogic: string[];
  grammar: { name: string; explanation: string; evidence?: string; examples: string[] }[];
  vocab: { word: string; pinyin?: string; gloss?: string; examples: string[] }[];
};

type HitKind = 'grammar' | 'vocab';

type Hit = {
  kind: HitKind;
  key: string;
  start: number;
  end: number;
  label: string;
  index: number; // index in corresponding array
};

type Segment = {
  text: string;
  hit?: Hit;
};

function uniq<T>(arr: T[]) {
  return Array.from(new Set(arr));
}

function buildHits(article: string, res: Analysis): Hit[] {
  const hits: Hit[] = [];

  // 1) Grammar hits: use evidence snippets if available
  const gPatterns = res.grammar
    .map((g, idx) => ({
      idx,
      key: `g:${idx}:${g.name}`,
      pattern: (g.evidence ?? '').trim(),
      label: g.name,
    }))
    .filter((x) => x.pattern.length >= 2);

  // 2) Vocab hits: use word itself
  const vPatterns = res.vocab
    .map((v, idx) => ({
      idx,
      key: `v:${idx}:${v.word}`,
      pattern: v.word.trim(),
      label: v.word,
    }))
    .filter((x) => x.pattern.length >= 1);

  // Reduce over-highlighting: dedupe patterns
  const all = [...gPatterns, ...vPatterns]
    .filter((p) => p.pattern && p.pattern.length)
    .sort((a, b) => b.pattern.length - a.pattern.length);

  const seenPattern = new Set<string>();
  const patterns = all.filter((p) => {
    if (seenPattern.has(p.pattern)) return false;
    seenPattern.add(p.pattern);
    return true;
  });

  // Find all occurrences (simple exact match)
  for (const p of patterns) {
    let from = 0;
    while (from < article.length) {
      const at = article.indexOf(p.pattern, from);
      if (at === -1) break;
      const hit: Hit = {
        kind: p.key.startsWith('g:') ? 'grammar' : 'vocab',
        key: p.key,
        start: at,
        end: at + p.pattern.length,
        label: p.label,
        index: p.idx,
      };
      hits.push(hit);
      from = at + p.pattern.length;
      // Hard cap to avoid too many spans
      if (hits.length > 120) break;
    }
    if (hits.length > 120) break;
  }

  // Resolve overlaps: sort by start then longer first; greedily accept
  hits.sort((a, b) => (a.start !== b.start ? a.start - b.start : b.end - b.start - (a.end - a.start)));

  const used = new Array(article.length).fill(false);
  const accepted: Hit[] = [];
  for (const h of hits) {
    let ok = true;
    for (let i = h.start; i < h.end; i++) {
      if (used[i]) {
        ok = false;
        break;
      }
    }
    if (!ok) continue;
    for (let i = h.start; i < h.end; i++) used[i] = true;
    accepted.push(h);
  }

  return accepted;
}

function splitToSegments(text: string, hits: Hit[]): Segment[] {
  if (!hits.length) return [{ text }];
  const segs: Segment[] = [];
  let cursor = 0;
  for (const h of hits) {
    if (h.start > cursor) segs.push({ text: text.slice(cursor, h.start) });
    segs.push({ text: text.slice(h.start, h.end), hit: h });
    cursor = h.end;
  }
  if (cursor < text.length) segs.push({ text: text.slice(cursor) });
  return segs;
}

export function ArticleGenerator({ level }: { level: UiLevelKey }) {
  const coreLevel = toCoreLevelNumber(level);
  const { lang, tb } = useI18n();

  const [topic, setTopic] = useState('在台灣生活：買東西與問路');
  const [genre, setGenre] = useState<'narrative' | 'dialogue' | 'expository'>('narrative');
  const [length, setLength] = useState<'short' | 'medium' | 'long'>('medium');
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<Analysis | null>(null);
  const [error, setError] = useState<string | null>(null);

  const [highlightOn, setHighlightOn] = useState(true);
  const [selected, setSelected] = useState<Hit | null>(null);

  const [bilingualExplainOn, setBilingualExplainOn] = useState(false);
  const [bilingualText, setBilingualText] = useState<string>('');
  const [translating, setTranslating] = useState(false);

  const segments = useMemo(() => {
    if (!result) return [{ text: '' }];
    if (!highlightOn) return [{ text: result.article }];
    const hits = buildHits(result.article, result);
    return splitToSegments(result.article, hits);
  }, [result, highlightOn]);

  async function generate() {
    setLoading(true);
    setError(null);
    setSelected(null);
    setBilingualText('');

    try {
      const res = await fetch('/api/article/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uiLevel: level, coreLevel, topic, genre, length }),
      });
      if (!res.ok) throw new Error(await res.text());
      const data = (await res.json()) as Analysis;
      setResult(data);
    } catch (e: any) {
      setError(e?.message ?? '生成失敗');
    } finally {
      setLoading(false);
    }
  }

  async function translateBreakdown() {
    if (!result) return;
    setTranslating(true);
    try {
      const payload = {
        levelLogic: result.levelLogic,
        grammar: result.grammar,
        vocab: result.vocab,
      };

      const msg =
        `請把以下教學內容翻譯成「${lang}」，並用「中文 / 目標語言」雙行格式呈現，` +
        `保留原本的條列結構（不要加入新內容）。

` +
        `內容：
` +
        JSON.stringify(payload, null, 2);

      const res = await fetch('/api/chat', {
