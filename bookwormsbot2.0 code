### 9.4 src/app/api/article/generate/route.ts（生成文章 + 拆解）

```ts
import { NextResponse } from 'next/server';
import { z } from 'zod';
import { db } from '@/db';
import { grammar, vocab } from '@/db/schema';
import { desc, lte } from 'drizzle-orm';
import { generateJson } from '@/lib/gemini';

const Body = z.object({
  uiLevel: z.string(),
  coreLevel: z.number().int().min(1).max(7),
  topic: z.string().min(1),
  genre: z.enum(['narrative', 'dialogue', 'expository']).default('narrative'),
  length: z.enum(['short', 'medium', 'long']).default('medium'),
});

export async function POST(req: Request) {
  const body = Body.parse(await req.json());

  const gPoints = await db
    .select({ name: grammar.name, description: grammar.description, example: grammar.example })
    .from(grammar)
    .where(lte(grammar.levelNum, body.coreLevel))
    .limit(18);

  const vWords = await db
    .select({ word: vocab.word, pinyin: vocab.pinyin, gloss: vocab.gloss })
    .from(vocab)
    .where(lte(vocab.levelNum, body.coreLevel))
    .orderBy(desc(vocab.wfreq))
    .limit(24);

  const schema = {
    type: 'object',
    properties: {
      title: { type: 'string' },
      article: { type: 'string' },
      levelLogic: { type: 'array', items: { type: 'string' } },
      grammar: {
        type: 'array',
        items: {
          type: 'object',
          properties: {
            name: { type: 'string' },
            explanation: { type: 'string' },
            evidence: { type: 'string' },
            examples: { type: 'array', items: { type: 'string' } }
          },
          required: ['name', 'explanation', 'examples']
        }
      },
      vocab: {
        type: 'array',
        items: {
          type: 'object',
          properties: {
            word: { type: 'string' },
            pinyin: { type: 'string' },
            gloss: { type: 'string' },
            examples: { type: 'array', items: { type: 'string' } }
          },
          required: ['word', 'examples']
        }
      }
    },
    required: ['title', 'article', 'levelLogic', 'grammar', 'vocab']
  };

  const system = `You are a Chinese teaching content generator for international students in Taiwan.\n` +
    `Return ONLY JSON (no markdown).`;

  const prompt = `Generate a ${body.genre} Chinese text about: ${body.topic}.\n` +
    `Target level: Core Level ${body.coreLevel} (TBCL ${body.uiLevel}).\n` +
    `Length: ${body.length}.\n\n` +
    `Use mostly the following vocabulary (not necessarily all):\n` +
    vWords.map(v => `- ${v.word}${v.pinyin ? ` (${v.pinyin})` : ''}${v.gloss ? `: ${v.gloss}` : ''}`).join('\n') +
    `\n\nPrefer using these grammar points (not necessarily all):\n` +
    gPoints.map(g => `- ${g.name}${g.example ? ` | ex: ${g.example}` : ''}`).join('\n') +
    `\n\nAfter writing, provide:\n` +
    `- levelLogic: 4~7 bullets explaining how this level typically builds sentences\n` +
    `- grammar: 6~10 items: name, explanation, evidence (a short quote from the article), 2~3 examples\n` +
    `- vocab: 10~16 items: word, pinyin(optional), gloss(optional), 2 examples\n`;

  const out = await generateJson<any>({
    system,
    prompt,
    schema,
    temperature: 0.5,
    maxOutputTokens: body.length === 'long' ? 2600 : 1800,
  });

  return NextResponse.json(out);
}
```

### 9.5 src/app/api/practice/cloze/route.ts（克漏字）

